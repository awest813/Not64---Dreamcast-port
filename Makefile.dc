# Not64 Dreamcast
#
# Host bring-up stub (supported ILP32 toolchain):
#   make -f Makefile.dc HOST=1
#   make -f Makefile.dc HOST=1 run
#   make -f Makefile.dc host-test          # Docker armhf + QEMU (see tools/dc/README.md)
#   make -f Makefile.dc help
#
# KallistiOS (needs KOS_BASE from environ.sh):
#   make -f Makefile.dc
#   make -f Makefile.dc VIDEO=pvr DEMO=1
#
# The host and SH4 builds enforce the same ILP32 memory contract.

.DEFAULT_GOAL := all
.SUFFIXES:
.DELETE_ON_ERROR:

PYTHON ?= python3
GFX ?= none
ifneq ($(filter $(GFX),none soft),$(GFX))
$(error GFX must be none or soft)
endif
GFX_SUFFIX = $(if $(filter soft,$(GFX)),-soft)
GAME_SUFFIX = $(if $(filter 1,$(GAME_DISC)),-game)

ifeq ($(GAME_DISC),1)
ifneq ($(GFX),soft)
$(error GAME_DISC=1 requires GFX=soft)
endif
endif

CORE_OBJS = \
	main/rom_dc.o \
	main/ROM-Cache-dc.o \
	platform/dc_debug.o \
	platform/dc_timers.o \
	platform/dc_config.o \
	platform/dc_settings.o \
	platform/dc_storage.o \
	platform/dc_savestates.o \
	platform/dc_overlay.o \
	platform/dc_nativesaves.o \
	platform/dc_plugins.o \
	platform/dc_gfx.o \
	platform/dc_vi.o \
	platform/dc_video.o \
	platform/dc_contract.o \
	platform/dc_recomp_stubs.o \
	r4300/r4300.o \
	r4300/cop0.o \
	r4300/special.o \
	r4300/regimm.o \
	r4300/exception.o \
	r4300/Invalid_Code.o \
	r4300/interupt.o \
	r4300/cop1.o \
	r4300/tlb.o \
	r4300/cop1_w.o \
	r4300/cop1_s.o \
	r4300/cop1_d.o \
	r4300/bc.o \
	r4300/cop1_l.o \
	r4300/pure_interp.o \
	r4300/compare_core.o \
	r4300/profile.o \
	gc_memory/tlb.o \
	gc_memory/TLB-Cache-hash.o \
	gc_memory/memory.o \
	gc_memory/dma.o \
	gc_memory/pif.o \
	gc_memory/flashram.o \
	gc_memory/n64_cic_nus_6105.o \
	gc_input/input.o \
	rsp_hle/alist.o \
	rsp_hle/alist_audio.o \
	rsp_hle/alist_naudio.o \
	rsp_hle/alist_nead.o \
	rsp_hle/audio.o \
	rsp_hle/cicx105.o \
	rsp_hle/hle.o \
	rsp_hle/hvqm.o \
	rsp_hle/jpeg.o \
	rsp_hle/memory.o \
	rsp_hle/mp3.o \
	rsp_hle/musyx.o \
	rsp_hle/re2.o \
	rsp_hle/plugin.o

DC_DEFS = -D__DREAMCAST__ -D__LINUX__ -DNOASM -DUSE_TLB_CACHE -DPIXEL_FORMAT=RGB565
ifeq ($(UI_BOOT),1)
DC_DEFS += -DDC_UI_BOOT
endif
ifeq ($(SOFT_IDENTITY_SPAN),1)
DC_DEFS += -DDC_SOFT_IDENTITY_SPAN
endif
ifeq ($(SOFT_COMBINE_SPAN),1)
ifneq ($(SOFT_IDENTITY_SPAN),1)
$(error SOFT_COMBINE_SPAN=1 requires SOFT_IDENTITY_SPAN=1)
endif
DC_DEFS += -DDC_SOFT_COMBINE_SPAN
endif
ifneq ($(filter test-interp-local %/test-interp-kernel.elf,$(MAKECMDGOALS)),)
DC_DEFS += -DDC_INTERP_ORACLE
endif
ifeq ($(VIDEO_HIRES),1)
DC_DEFS += -DDC_VI_HIGHRES
endif
ifeq ($(GAME_INPUT_REPLAY),1)
ifneq ($(GAME_DISC),1)
$(error GAME_INPUT_REPLAY=1 requires GAME_DISC=1)
endif
DC_DEFS += -DDC_GAME_INPUT_REPLAY
endif
ifeq ($(INTERP_DIRECT),1)
DC_DEFS += -DDC_INTERP_DIRECT
endif
ifeq ($(PERF),1)
DC_DEFS += -DDC_PERF
endif
ifeq ($(INTERP_ALU),1)
DC_DEFS += -DDC_INTERP_ALU
endif
ifeq ($(INTERP_MEMORY),1)
DC_DEFS += -DDC_INTERP_MEMORY
endif
ifeq ($(INTERP_EXPAND),1)
ifneq ($(INTERP_DIRECT)$(INTERP_ALU),11)
$(error INTERP_EXPAND=1 requires INTERP_DIRECT=1 INTERP_ALU=1)
endif
DC_DEFS += -DDC_INTERP_EXPAND
endif
ifeq ($(INTERP_LOCAL),1)
ifneq ($(INTERP_DIRECT)$(INTERP_MEMORY)$(INTERP_ALU),111)
$(error INTERP_LOCAL=1 requires INTERP_DIRECT=1 INTERP_MEMORY=1 INTERP_ALU=1)
endif
ifneq ($(filter 1,$(INTERP_BLOCK) $(CPU_PROFILE)),)
$(error INTERP_LOCAL=1 is separate from INTERP_BLOCK/CPU_PROFILE diagnostics)
endif
DC_DEFS += -DDC_INTERP_LOCAL
endif
ifeq ($(INTERP_THREAD),1)
ifneq ($(INTERP_DIRECT)$(INTERP_MEMORY)$(INTERP_ALU),111)
$(error INTERP_THREAD=1 requires INTERP_DIRECT=1 INTERP_MEMORY=1 INTERP_ALU=1)
endif
ifneq ($(filter 1,$(HOST) $(INTERP_LOCAL) $(INTERP_BLOCK) $(CPU_PROFILE)),)
$(error INTERP_THREAD=1 requires native SH4 and separate LOCAL/BLOCK/PROFILE diagnostics)
endif
DC_DEFS += -DDC_INTERP_THREAD
CORE_OBJS += platform/dc_interp_thread.o
endif
ifeq ($(INTERP_PC_LAZY),1)
ifneq ($(INTERP_DIRECT)$(INTERP_MEMORY)$(INTERP_ALU),111)
$(error INTERP_PC_LAZY=1 requires INTERP_DIRECT=1 INTERP_MEMORY=1 INTERP_ALU=1)
endif
ifneq ($(filter 1,$(INTERP_LOCAL) $(INTERP_THREAD)),)
$(error INTERP_PC_LAZY=1 is separate from LOCAL/THREAD diagnostics)
endif
DC_DEFS += -DDC_INTERP_PC_LAZY
endif
ifeq ($(INTERP_COUNT_INLINE),1)
DC_DEFS += -DDC_INTERP_COUNT_INLINE
endif
ifeq ($(INTERP_DELAY_ALU),1)
ifneq ($(INTERP_DIRECT)$(INTERP_MEMORY)$(INTERP_ALU),111)
$(error INTERP_DELAY_ALU=1 requires INTERP_DIRECT=1 INTERP_MEMORY=1 INTERP_ALU=1)
endif
DC_DEFS += -DDC_INTERP_DELAY_ALU
endif
ifeq ($(INTERP_BRANCH_PAIR),1)
ifneq ($(INTERP_DIRECT)$(INTERP_MEMORY)$(INTERP_ALU),111)
$(error INTERP_BRANCH_PAIR=1 requires INTERP_DIRECT=1 INTERP_MEMORY=1 INTERP_ALU=1)
endif
ifneq ($(filter 1,$(INTERP_BLOCK) $(INTERP_LOCAL) $(INTERP_THREAD) $(CPU_PROFILE)),)
$(error INTERP_BRANCH_PAIR=1 is separate from BLOCK/LOCAL/THREAD/PROFILE diagnostics)
endif
DC_DEFS += -DDC_INTERP_BRANCH_PAIR
endif
ifeq ($(INTERP_COMPACT),1)
ifneq ($(INTERP_DIRECT)$(INTERP_MEMORY)$(INTERP_ALU),111)
$(error INTERP_COMPACT=1 requires INTERP_DIRECT=1 INTERP_MEMORY=1 INTERP_ALU=1)
endif
ifneq ($(filter 1,$(INTERP_BLOCK) $(INTERP_LOCAL) $(INTERP_THREAD) $(INTERP_EXPAND) $(INTERP_BRANCH_PAIR) $(CPU_PROFILE)),)
$(error INTERP_COMPACT=1 is separate from alternate dispatch/cache/profile experiments)
endif
DC_DEFS += -DDC_INTERP_COMPACT
endif
ifeq ($(CPU_PROFILE),1)
DC_DEFS += -DDC_CPU_PROFILE
endif
ifeq ($(CPU_TRACE_HOST),1)
ifneq ($(HOST)$(CPU_PROFILE),11)
$(error CPU_TRACE_HOST=1 requires HOST=1 CPU_PROFILE=1)
endif
DC_DEFS += -DDC_CPU_TRACE_HOST
endif
ifeq ($(INTERP_BLOCK_REUSE),1)
ifneq ($(INTERP_BLOCK),1)
$(error INTERP_BLOCK_REUSE=1 requires INTERP_BLOCK=1)
endif
DC_DEFS += -DDC_INTERP_BLOCK_REUSE
endif
ifeq ($(INTERP_BLOCK_FRONTIER),1)
ifneq ($(INTERP_BLOCK),1)
$(error INTERP_BLOCK_FRONTIER=1 requires INTERP_BLOCK=1)
endif
DC_DEFS += -DDC_INTERP_BLOCK_FRONTIER
endif
ifeq ($(INTERP_BLOCK_RAM_PROOF),1)
ifneq ($(INTERP_BLOCK),1)
$(error INTERP_BLOCK_RAM_PROOF=1 requires INTERP_BLOCK=1)
endif
DC_DEFS += -DDC_INTERP_BLOCK_RAM_PROOF
endif
ifeq ($(INTERP_BLOCK_STORES),1)
ifneq ($(INTERP_BLOCK),1)
$(error INTERP_BLOCK_STORES=1 requires INTERP_BLOCK=1)
endif
DC_DEFS += -DDC_INTERP_BLOCK_STORES
endif
ifeq ($(INTERP_BLOCK_EPOCH),1)
ifneq ($(INTERP_BLOCK),1)
$(error INTERP_BLOCK_EPOCH=1 requires INTERP_BLOCK=1)
endif
DC_DEFS += -DDC_INTERP_BLOCK_EPOCH
endif
ifeq ($(INTERP_BLOCK_PROFILE),1)
ifneq ($(INTERP_BLOCK),1)
$(error INTERP_BLOCK_PROFILE=1 requires INTERP_BLOCK=1)
endif
DC_DEFS += -DDC_INTERP_BLOCK_PROFILE
endif
ifeq ($(INTERP_BLOCK_DISPATCH),1)
ifneq ($(INTERP_BLOCK)$(INTERP_BLOCK_FRONTIER),11)
$(error INTERP_BLOCK_DISPATCH=1 requires INTERP_BLOCK=1 INTERP_BLOCK_FRONTIER=1)
endif
DC_DEFS += -DDC_INTERP_BLOCK_DISPATCH
endif
ifeq ($(INTERP_BLOCK_ARENA),1)
ifneq ($(INTERP_BLOCK),1)
$(error INTERP_BLOCK_ARENA=1 requires INTERP_BLOCK=1)
endif
DC_DEFS += -DDC_INTERP_BLOCK_ARENA
endif
ifeq ($(INTERP_BLOCK_HOT_ENTRY),1)
ifneq ($(INTERP_BLOCK_ARENA)$(INTERP_BLOCK_EPOCH)$(INTERP_BLOCK_DISPATCH),111)
$(error INTERP_BLOCK_HOT_ENTRY=1 requires ARENA=1 EPOCH=1 DISPATCH=1)
endif
ifeq ($(INTERP_BLOCK_PROFILE),1)
$(error INTERP_BLOCK_HOT_ENTRY=1 is separate from sampled block diagnostics)
endif
DC_DEFS += -DDC_INTERP_BLOCK_HOT_ENTRY
endif
ifeq ($(INTERP_BLOCK),1)
ifneq ($(INTERP_DIRECT)$(INTERP_MEMORY)$(INTERP_ALU),111)
$(error INTERP_BLOCK=1 requires INTERP_DIRECT=1 INTERP_MEMORY=1 INTERP_ALU=1)
endif
ifeq ($(CPU_PROFILE),1)
$(error INTERP_BLOCK=1 and CPU_PROFILE=1 are separate diagnostics)
endif
INTERP_BLOCK_KB ?= 512
ifeq ($(filter $(INTERP_BLOCK_KB),512 1024 2048),)
$(error INTERP_BLOCK_KB must be 512, 1024 or 2048)
endif
DC_DEFS += -DDC_INTERP_BLOCK -DDC_INTERP_BLOCK_KB=$(INTERP_BLOCK_KB)
CORE_OBJS += platform/dc_interp_block.o
endif
ifeq ($(MEMORY_PROFILE),1)
DC_DEFS += -DDC_MEMORY_PROFILE
endif
ifeq ($(FRAME_AUDIT),1)
ifneq ($(STATE_AUDIT),1)
$(error FRAME_AUDIT=1 requires STATE_AUDIT=1)
endif
DC_DEFS += -DDC_FRAME_AUDIT
endif
ifeq ($(STATE_AUDIT),1)
DC_DEFS += -DDC_STATE_AUDIT
endif
ifeq ($(SOFT_PROFILE),1)
DC_DEFS += -DDC_SOFT_PROFILE
endif
# Legacy register/memory views intentionally alias 32-bit and 64-bit words.
ifeq ($(GFX),soft)
DC_DEFS += -DDC_SOFT_GFX
ifeq ($(RSP_LAZY_CLIP),1)
DC_DEFS += -DDC_RSP_LAZY_CLIP
endif
ifeq ($(SOFT_REFERENCE),1)
DC_DEFS += -DDC_SOFT_REFERENCE
endif
ifeq ($(GAME_DISC),1)
DC_DEFS += -DDC_GAME_DISC
GAME_FRAMES ?= 600
ifneq ($(origin GAME_FRAMESKIP),undefined)
ifeq ($(filter $(GAME_FRAMESKIP),0 1 2 3 4 5 6 7),)
$(error GAME_FRAMESKIP must be 0 through 7 (6 balanced; 7 steady))
endif
DC_DEFS += -DDC_GAME_FRAMESKIP=$(GAME_FRAMESKIP)
endif
GAME_STEPS ?= 500000000
GAME_START ?= 400
DC_DEFS += -DDC_GAME_FRAMES=$(GAME_FRAMES) -DDC_GAME_STEPS=$(GAME_STEPS) -DDC_GAME_START=$(GAME_START)
ifeq ($(GAME_CHECKPOINT),1)
DC_DEFS += -DDC_GAME_CHECKPOINT
endif
endif
endif
DC_DEFS += -fno-strict-aliasing -include platform/dc_abi.h

VIDEO_OBJS =
SOFT_OBJS =
ifeq ($(GFX),soft)
SOFT_OBJS = platform/dc_soft.o $(addprefix mupen64_soft_gfx/,rsp.o rdp.o rs.o tx.o tf.o cc.o bl.o)
endif
ifeq ($(RASTER_PVR),1)
ifneq ($(GFX),soft)
$(error RASTER_PVR=1 requires GFX=soft)
endif
ifeq ($(HOST),1)
$(error RASTER_PVR=1 requires the KOS target)
endif
ifneq ($(VIDEO),pvr)
$(error RASTER_PVR=1 requires VIDEO=pvr)
endif
DC_DEFS += -DDC_RASTER_PVR
ifeq ($(RASTER_WIDE),1)
ifneq ($(VIDEO_HIRES),1)
$(error RASTER_WIDE=1 requires VIDEO_HIRES=1)
endif
DC_DEFS += -DDC_RASTER_WIDE
endif
ifeq ($(RASTER_SHADE),1)
DC_DEFS += -DDC_RASTER_SHADE
endif
ifeq ($(RASTER_STRICT),1)
DC_DEFS += -DDC_RASTER_STRICT
endif
ifeq ($(RASTER_BATCH_CACHE),1)
DC_DEFS += -DDC_RASTER_BATCH_CACHE
endif
ifeq ($(RASTER_IDENTITY),1)
ifneq ($(RASTER_SHADE),1)
$(error RASTER_IDENTITY=1 requires RASTER_SHADE=1)
endif
DC_DEFS += -DDC_RASTER_IDENTITY
endif
ifeq ($(RASTER_FULL_ALPHA),1)
ifneq ($(RASTER_IDENTITY),1)
$(error RASTER_FULL_ALPHA=1 requires RASTER_IDENTITY=1)
endif
DC_DEFS += -DDC_RASTER_FULL_ALPHA
endif
ifeq ($(RASTER_TEXTURE_ALPHA),1)
ifneq ($(RASTER_FULL_ALPHA),1)
$(error RASTER_TEXTURE_ALPHA=1 requires RASTER_FULL_ALPHA=1)
endif
DC_DEFS += -DDC_RASTER_TEXTURE_ALPHA
endif
ifeq ($(RASTER_CVG_POINT),1)
ifneq ($(RASTER_FULL_ALPHA),1)
$(error RASTER_CVG_POINT=1 requires RASTER_FULL_ALPHA=1)
endif
DC_DEFS += -DDC_RASTER_CVG_POINT
endif
ifeq ($(RASTER_RECT_SAMPLE),1)
DC_DEFS += -DDC_RASTER_RECT_SAMPLE
endif
ifeq ($(RASTER_TEXEL_SCALE),1)
ifneq ($(RASTER_RECT_SAMPLE),1)
$(error RASTER_TEXEL_SCALE=1 requires RASTER_RECT_SAMPLE=1)
endif
DC_DEFS += -DDC_RASTER_TEXEL_SCALE
endif
ifeq ($(RASTER_CACHE_INDEX),1)
ifneq ($(RASTER_BATCH_CACHE),1)
$(error RASTER_CACHE_INDEX=1 requires RASTER_BATCH_CACHE=1)
endif
DC_DEFS += -DDC_RASTER_CACHE_INDEX
endif
ifeq ($(RASTER_SHADE_SCALE),1)
ifneq ($(RASTER_TEXEL_SCALE)$(RASTER_SHADE),11)
$(error RASTER_SHADE_SCALE=1 requires RASTER_TEXEL_SCALE=1 RASTER_SHADE=1)
endif
DC_DEFS += -DDC_RASTER_SHADE_SCALE
endif
ifeq ($(RASTER_TRI_ORIGIN),1)
ifneq ($(RASTER_TEXEL_SCALE),1)
$(error RASTER_TRI_ORIGIN=1 requires RASTER_TEXEL_SCALE=1)
endif
DC_DEFS += -DDC_RASTER_TRI_ORIGIN
endif
ifeq ($(RASTER_FILTER_GRID),1)
ifneq ($(RASTER_TRI_ORIGIN)$(RASTER_SHADE_SCALE),11)
$(error RASTER_FILTER_GRID=1 requires RASTER_TRI_ORIGIN=1 RASTER_SHADE_SCALE=1)
endif
DC_DEFS += -DDC_RASTER_FILTER_GRID
endif
ifeq ($(RASTER_RECT_CLIP),1)
DC_DEFS += -DDC_RASTER_RECT_CLIP
endif
ifeq ($(RASTER_CUTOUT),1)
ifneq ($(RASTER_SHADE),1)
$(error RASTER_CUTOUT=1 requires RASTER_SHADE=1)
endif
DC_DEFS += -DDC_RASTER_CUTOUT
endif
ifeq ($(RASTER_PROFILE),1)
DC_DEFS += -DDC_RASTER_PROFILE
endif
SOFT_OBJS += platform/dc_raster_pvr.o
endif
ifeq ($(RASTER_WIDE),1)
ifneq ($(RASTER_PVR),1)
$(error RASTER_WIDE=1 requires RASTER_PVR=1)
endif
endif
ifeq ($(RASTER_STRICT),1)
ifneq ($(RASTER_PVR),1)
$(error RASTER_STRICT=1 requires RASTER_PVR=1)
endif
endif

SKIP_TOOLCHAIN :=
ifneq ($(filter help host-test clean,$(MAKECMDGOALS)),)
ifeq ($(filter-out help host-test clean,$(MAKECMDGOALS)),)
SKIP_TOOLCHAIN := 1
endif
endif

ifeq ($(SKIP_TOOLCHAIN),1)
BUILD_DIR := build/dc
TARGET := unused
MENU_OBJS :=
else ifeq ($(HOST),1)
ifneq ($(origin VIDEO),undefined)
$(error VIDEO= is KallistiOS-only; omit it for HOST=1 (see make -f Makefile.dc help))
endif
ifneq ($(origin DEMO),undefined)
$(error DEMO= is KallistiOS-only; omit it for HOST=1 (see make -f Makefile.dc help))
endif
ifeq ($(GAME_DISC),1)
$(error GAME_DISC=1 is a KallistiOS disc image path; omit it for HOST=1)
endif
CC ?= gcc
CFLAGS ?= -std=gnu11 -fgnu89-inline -Wall -Wextra -Werror=implicit-function-declaration \
    -Wno-unused-parameter \
    -Wno-missing-field-initializers -Wno-unused-function \
    -Wno-unused-variable -Wno-pointer-sign -Wno-multichar -O1 -g
MENU_OBJS = platform/dc_menu/dc_menu.o platform/dc_menu/dc_draw_host.o
CPPFLAGS += $(DC_DEFS) -DDC_HOST_STUB -I$(CURDIR)
BUILD_DIR ?= build/dc/host-$(shell $(CC) -dumpmachine)$(GFX_SUFFIX)
TARGET = $(BUILD_DIR)/not64-dc-bringup
RUNNER ?=
DC_CC = $(CC)
DC_CXX = $(patsubst %gcc,%g++,$(CC))
DC_CFLAGS = $(CPPFLAGS) $(CFLAGS)
DC_LDFLAGS = $(LDFLAGS)
DC_LIBS = -lm
HOST_LONG_SIZE := $(shell $(CC) $(CFLAGS) -dM -E -x c /dev/null 2>/dev/null | awk '/__SIZEOF_LONG__/ { print $$3 }')
ifneq ($(HOST_LONG_SIZE),4)
$(error HOST=1 needs ILP32 (this $(CC) has sizeof(long)=$(or $(HOST_LONG_SIZE),unknown)). Run: make -f Makefile.dc host-test)
endif
else
ifndef KOS_BASE
$(error KOS_BASE is not set. Host tests: make -f Makefile.dc host-test. KOS ELF: source environ.sh. See tools/dc/README.md)
endif
include $(KOS_BASE)/Makefile.rules
VIDEO ?= software
ifeq ($(filter $(VIDEO),software pvr),)
$(error VIDEO must be software or pvr)
endif
ifeq ($(DEMO),1)
ifeq ($(GAME_DISC),1)
$(error DEMO=1 embeds vitest; GAME_DISC=1 is a separate game-disc ELF)
endif
endif
MENU_OBJS = platform/dc_menu/dc_menu.o platform/dc_menu/dc_draw_kos.o
VIDEO_OBJS = platform/dc_video_kos.o platform/dc_kos_compat.o
ifeq ($(VIDEO),pvr)
VIDEO_OBJS += platform/dc_pvr.o
DC_DEFS += -DDC_VIDEO_PVR
# Hashing costs more than DMA in Flycast; opt in for hardware measurements.
ifeq ($(UPLOAD_SKIP),1)
DC_DEFS += -DDC_VIDEO_UPLOAD_SKIP
endif
TARGET = not64-dc-pvr$(GFX_SUFFIX)$(GAME_SUFFIX).elf
else
TARGET = not64-dc$(GFX_SUFFIX)$(GAME_SUFFIX).elf
endif
ifeq ($(DEMO),1)
DC_DEFS += -DDC_EMBED_VITEST
BUILD_DIR ?= build/dc/kos-$(VIDEO)$(GFX_SUFFIX)-demo
TARGET = not64-dc-$(VIDEO)$(GFX_SUFFIX)-demo.elf
DEMO_OBJ = $(BUILD_DIR)/romdisk.o
else
BUILD_DIR ?= build/dc/kos-$(VIDEO)$(GFX_SUFFIX)$(GAME_SUFFIX)
endif
DC_CC = $(KOS_CC)
DC_CXX = $(patsubst %gcc,%g++,$(KOS_CC))
DC_CFLAGS = $(KOS_CFLAGS) $(DC_DEFS) -I$(CURDIR) -std=gnu11 -fgnu89-inline \
    -Werror=implicit-function-declaration
DC_LDFLAGS = $(KOS_LDFLAGS) -Wl,-Map,$(BUILD_DIR)/not64-dc.map
DC_LIBS = $(OBJEXTRA) $(KOS_LIBS) -lm
endif

SOURCE_OBJS = main/main_dc.o \
	platform/dc_menu/dc_ui.o \
	fileBrowser/fileBrowser.o \
	fileBrowser/fileBrowser-kos.o \
	gc_input/controller-DC.o \
	gc_audio/audio-dc.o \
	$(MENU_OBJS) \
	$(CORE_OBJS) \
	$(VIDEO_OBJS) \
	$(SOFT_OBJS)

ifeq ($(LTO),1)
DC_CFLAGS += -flto
DC_LDFLAGS += -flto
endif

ifeq ($(GFX),soft)
DC_LIBS := -Wl,--start-group -lstdc++ $(DC_LIBS) -Wl,--end-group
endif

OBJS = $(addprefix $(BUILD_DIR)/,$(SOURCE_OBJS))
TEST_OBJS = $(BUILD_DIR)/tests/dc/test_contract.o $(BUILD_DIR)/tests/dc/rsp_memory_probe.o
TEST_TARGET = $(BUILD_DIR)/test-contract
VI_TEST_TARGET = $(BUILD_DIR)/test-vi
SOFT_TEST_TARGET = $(BUILD_DIR)/test-soft
ROMS = roms/dc_dummy.z64 roms/dc_cputest.z64 roms/dc_vitest.z64
CONFIG_STAMP = $(BUILD_DIR)/compiler-flags
HOST_IMAGE ?= not64-dc-host:arm32

.PHONY: all clean run test test-soft help host-test FORCE
all: $(ROMS) $(TARGET)

help:
	@printf '%s\n' \
	  'Not64 Dreamcast — Makefile.dc' \
	  '' \
	  'Host (ILP32; native LP64 gcc is rejected):' \
	  '  make -f Makefile.dc host-test' \
	  '  make -f Makefile.dc HOST=1 CC=arm-linux-gnueabihf-gcc RUNNER='\''qemu-arm -L /usr/arm-linux-gnueabihf'\'' test' \
	  '  make -f Makefile.dc HOST=1 GFX=soft ... test-soft' \
	  '' \
	  'KallistiOS (requires KOS_BASE):' \
	  '  make -f Makefile.dc' \
	  '  make -f Makefile.dc VIDEO=pvr|software [DEMO=1] [GFX=soft] [GAME_DISC=1]' \
	  '  RASTER_PVR=1 enables experimental PVR geometry; INTERP_DIRECT=1 streamlines operand decoding.' \
	  '  RASTER_STRICT=1 restricts GPU work to replay-tested opaque fills (requires RASTER_PVR=1).' \
	  '  RASTER_WIDE=1 adds experimental native 640-pixel GPU canvases (requires VIDEO_HIRES=1).' \
	  '  RASTER_IDENTITY=1 opts into additional identity blending; RASTER_BATCH_CACHE=1 tests 256 pinned entries.' \
	  '  RASTER_CUTOUT=1 adds experimental texture-alpha shade triangles (requires RASTER_SHADE=1).' \
	  '  RASTER_FULL_ALPHA=1 and RASTER_RECT_CLIP=1 add guarded opaque-alpha and integer-scissor cases.' \
	  '  RASTER_TEXTURE_ALPHA=1 proves uniform raw texture opacity (requires RASTER_FULL_ALPHA=1).' \
	  '  RASTER_CVG_POINT=1 tests exact integer identity coverage masks (requires RASTER_FULL_ALPHA=1).' \
	  '  RASTER_RECT_SAMPLE=1 and RASTER_TEXEL_SCALE=1 correct qualified rectangle sampling/packed colors.' \
	  '  RASTER_SHADE_SCALE=1 corrects packed-texel expansion in separable shade equations (requires both TEXEL_SCALE/SHADE).' \
	  '  RASTER_TRI_ORIGIN=1 corrects triangle attribute sampling without moving geometry (requires TEXEL_SCALE).' \
	  '  RASTER_FILTER_GRID=1 refines small filtered shade textures (requires TRI_ORIGIN/SHADE_SCALE).' \
	  '  RASTER_FILTER_GRID=1 refines small filtered shade textures (requires TRI_ORIGIN/SHADE_SCALE).' \
	  '  RASTER_CACHE_INDEX=1 adds collision-checked indexed texture lookup (requires RASTER_BATCH_CACHE=1).' \
	  '  INTERP_BLOCK=1 opts into experimental SH4 integer blocks; INTERP_BLOCK_KB=512|1024|2048 bounds RAM.' \
  '  INTERP_BLOCK_STORES=1 guards continuation; INTERP_BLOCK_REUSE/FRONTIER/RAM_PROOF/EPOCH are opt-in.' \
	  '  INTERP_LOCAL=1, INTERP_THREAD=1 and INTERP_PC_LAZY=1 are separate optional CPU experiments.' \
	  '  INTERP_COUNT_INLINE=1 preserves Count boundaries with a pure-core inline update.' \
	  '  INTERP_DELAY_ALU=1 tests direct delay-slot dispatch (requires DIRECT, MEMORY and ALU).' \
	  '  SOFT_IDENTITY_SPAN=1 tests scalar identity rectangle spans; INTERP_BLOCK_PROFILE=1 diagnoses native costs.' \
	  '  SOFT_COMBINE_SPAN=1 tests exact simple combiners within IDENTITY_SPAN; INTERP_BRANCH_PAIR=1 tests simple delays.' \
	  '  INTERP_BLOCK_DISPATCH=1 rejects unsupported starts at fetch (requires BLOCK and FRONTIER).' \
	  '  INTERP_BLOCK_ARENA=1 tests compact metadata and bounded relocated native code.' \
	  '  STATE_AUDIT=1 prints post-run CPU/event bytes and memory checksums; MEMORY_PROFILE=1 reports allocator use.' \
	  '  FRAME_AUDIT=1 adds untimed visible RGB565 RLE exports (requires STATE_AUDIT=1).' \
	  '  RASTER_PROFILE=1 adds expensive per-texture timings; PERF=1 measures actual game frames.' \
	  '  Add UPLOAD_SKIP=1 to measure PVR hash/upload reuse (slower in Flycast).' \
	  '  SOFT_PROFILE=1 reports cumulative RDP draw-category timings every 60 display lists.' \
	  '  PERF=1 prints cumulative game-phase timings every 60 frames; LTO=1 enables cross-file optimization.' \
	  '  GAME_DISC=1 GAME_FRAMES=0 GAME_STEPS=0 GAME_START=0 runs without diagnostic limits or synthetic Start.' \
	  '  GAME_CHECKPOINT=1 resumes /cd/boot.st after loading the game ROM (GAME_DISC=1).' \
	  '  VIDEO_HIRES=1 enables experimental 640x480 field-weave scanout (1 MiB staging).' \
	  '  GAME_INPUT_REPLAY=1 reads recorded Maple inputs from /cd/input.txt (GAME_DISC=1).' \
	  '  GAME_FRAMESKIP=0..5 skips N after each draw; 6 alternates 2/3; 7 repeats 2/3/3/3. CLI aliases: balanced|steady.' \
	  '  INTERP_MEMORY=1 and INTERP_ALU=1 enable optional interpreter RAM/dispatch shortcuts.' \
	  '' \
	  'Flags: HOST=1  VIDEO=software|pvr  GFX=none|soft  DEMO=1  GAME_DISC=1' \
	  'Docs:  tools/dc/README.md'

host-test:
	@command -v docker >/dev/null 2>&1 || { \
	  echo 'host-test needs docker. Install the ILP32 image from tools/dc/README.md' >&2; \
	  exit 1; }
	docker build -t $(HOST_IMAGE) -f tools/dc/Dockerfile.host tools/dc
	docker run --rm -v "$(CURDIR):/workspace" -w /workspace $(HOST_IMAGE)

# A stamp avoids races between the two ROM outputs under parallel make.
$(BUILD_DIR)/roms.stamp: roms/gen_dc_roms.py
	@mkdir -p $(@D)
	$(PYTHON) $<
	@touch $@

$(ROMS): $(BUILD_DIR)/roms.stamp
	@test -f $@ || $(PYTHON) roms/gen_dc_roms.py

# Rebuild when compiler/options change, even within one target architecture.
$(CONFIG_STAMP): FORCE
	@mkdir -p $(@D)
	@printf '%s\n' '$(DC_CC) $(DC_CFLAGS) $(DC_LDFLAGS) $(DC_LIBS)' > $@.tmp
	@cmp -s $@.tmp $@ && rm $@.tmp || mv $@.tmp $@

$(TARGET): $(OBJS) $(DEMO_OBJ)
	$(DC_CC) $(DC_CFLAGS) $(DC_LDFLAGS) -o $@ $(KOS_START) $(OBJS) $(DEMO_OBJ) $(DC_LIBS)

ifeq ($(DEMO),1)
$(BUILD_DIR)/romdisk.o: roms/dc_vitest.z64
	@mkdir -p $(BUILD_DIR)/romdisk/roms
	cp $< $(BUILD_DIR)/romdisk/roms/
	$(KOS_GENROMFS) -f $(BUILD_DIR)/romdisk.img -d $(BUILD_DIR)/romdisk
	$(KOS_BASE)/utils/bin2o/bin2o $(BUILD_DIR)/romdisk.img romdisk $@
endif

$(BUILD_DIR)/%.o: %.c $(CONFIG_STAMP)
	@mkdir -p $(@D)
	$(DC_CC) $(DC_CFLAGS) -MMD -MP -c -o $@ $<

$(BUILD_DIR)/%.o: %.S $(CONFIG_STAMP)
	@mkdir -p $(@D)
	$(DC_CC) $(filter-out -std=gnu11 -fgnu89-inline -Werror=implicit-function-declaration,$(DC_CFLAGS)) -MMD -MP -c -o $@ $<

$(BUILD_DIR)/%.o: %.cpp $(CONFIG_STAMP)
	@mkdir -p $(@D)
	$(DC_CXX) $(filter-out -std=gnu11 -fgnu89-inline -Werror=implicit-function-declaration -Wno-pointer-sign,$(DC_CFLAGS)) -std=gnu++11 -MMD -MP -c -o $@ $<

$(BUILD_DIR)/test-interp-kernel.elf: $(filter-out $(BUILD_DIR)/main/main_dc.o,$(OBJS)) $(BUILD_DIR)/tests/dc/test_interp_local.o
	$(DC_CC) $(DC_CFLAGS) $(DC_LDFLAGS) -o $@ $(KOS_START) $^ $(DC_LIBS)

ifeq ($(HOST),1)
$(TEST_TARGET): $(filter-out $(BUILD_DIR)/main/main_dc.o,$(OBJS)) $(TEST_OBJS)
	$(DC_CC) $(DC_CFLAGS) $(DC_LDFLAGS) -o $@ $^ $(DC_LIBS)

$(SOFT_TEST_TARGET): $(BUILD_DIR)/tests/dc/test_soft.o $(addprefix $(BUILD_DIR)/mupen64_soft_gfx/,rsp.o rdp.o rs.o tx.o tf.o cc.o bl.o)
	$(DC_CXX) $(filter-out -std=gnu11 -fgnu89-inline -Werror=implicit-function-declaration -Wno-pointer-sign,$(DC_CFLAGS)) $(DC_LDFLAGS) -o $@ $^ $(DC_LIBS)

$(BUILD_DIR)/test-interp-local: $(filter-out $(BUILD_DIR)/main/main_dc.o,$(OBJS)) $(BUILD_DIR)/tests/dc/test_interp_local.o
	$(DC_CC) $(DC_CFLAGS) $(DC_LDFLAGS) -o $@ $^ $(DC_LIBS)

.PHONY: test-interp-local
test-interp-local: $(BUILD_DIR)/test-interp-local
	$(RUNNER) ./$(BUILD_DIR)/test-interp-local

ifeq ($(GFX),soft)
test-soft: $(SOFT_TEST_TARGET)
	$(RUNNER) ./$(SOFT_TEST_TARGET)
else
test-soft:
	$(error test-soft requires GFX=soft)
endif

run: all
	$(RUNNER) ./$(TARGET)

$(VI_TEST_TARGET): $(BUILD_DIR)/tests/dc/test_vi.o $(BUILD_DIR)/platform/dc_vi.o $(BUILD_DIR)/platform/dc_video.o
	$(DC_CC) $(DC_CFLAGS) $(DC_LDFLAGS) -o $@ $^ $(DC_LIBS)

$(BUILD_DIR)/test-vi-hires: tests/dc/test_vi_hires.c platform/dc_vi.c platform/dc_video.c platform/dc_vi.h platform/dc_video.h $(CONFIG_STAMP)
	$(DC_CC) $(DC_CFLAGS) -DDC_VI_HIGHRES $(DC_LDFLAGS) -o $@ tests/dc/test_vi_hires.c platform/dc_vi.c platform/dc_video.c $(DC_LIBS)

.PHONY: test-hires
test-hires: $(BUILD_DIR)/test-vi-hires
	$(RUNNER) ./$(BUILD_DIR)/test-vi-hires

TEST_SOFT_PREREQ =
ifeq ($(GFX),soft)
TEST_SOFT_PREREQ = $(SOFT_TEST_TARGET)
endif

test: all $(TEST_TARGET) $(VI_TEST_TARGET) $(TEST_SOFT_PREREQ)
	$(RUNNER) ./$(TEST_TARGET)
	$(RUNNER) ./$(VI_TEST_TARGET)
	$(RUNNER) ./$(TARGET) roms/dc_cputest.z64
	$(RUNNER) ./$(TARGET) roms/dc_dummy.z64
	$(RUNNER) ./$(TARGET) roms/dc_vitest.z64 300000 --frames 2 --capture $(BUILD_DIR)/vitest.ppm
	$(PYTHON) tests/dc/check_capture.py $(BUILD_DIR)/vitest.ppm
	$(PYTHON) tests/dc/check_rom_formats.py $(RUNNER) ./$(TARGET)
ifeq ($(GFX),soft)
	$(RUNNER) ./$(SOFT_TEST_TARGET)
endif
endif

clean:
	rm -rf build/dc
	rm -f not64-dc.elf not64-dc-pvr.elf not64-dc-software-demo.elf not64-dc-pvr-demo.elf \
	      not64-dc-soft.elf not64-dc-pvr-soft.elf not64-dc-pvr-soft-game.elf \
	      not64-dc-pvr-soft-demo.elf not64-dc-software-soft-demo.elf

-include $(OBJS:.o=.d) $(TEST_OBJS:.o=.d) $(BUILD_DIR)/tests/dc/test_vi.d $(BUILD_DIR)/tests/dc/test_soft.d

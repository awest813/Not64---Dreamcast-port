# Not64 Dreamcast
#
# Host:
#   make -f Makefile.dc HOST=1
#   make -f Makefile.dc HOST=1 run
#   See tools/dc/README.md for the supported ILP32 Docker host.
#
# KallistiOS:
#   make -f Makefile.dc

.DEFAULT_GOAL := all
GFX ?= none
ifneq ($(filter $(GFX),none soft),$(GFX))
$(error GFX must be none or soft)
endif
GFX_SUFFIX = $(if $(filter soft,$(GFX)),-soft)
GAME_SUFFIX = $(if $(filter 1,$(GAME_DISC)),-game)

CORE_OBJS = \
	main/rom_dc.o \
	main/ROM-Cache-dc.o \
	platform/dc_debug.o \
	platform/dc_timers.o \
	platform/dc_config.o \
	platform/dc_savestates.o \
	platform/dc_plugins.o \
	platform/dc_gfx.o \
	platform/dc_vi.o \
	platform/dc_video.o \
	platform/dc_contract.o \
	platform/dc_recomp_stubs.o \
	r4300/r4300.o \
	r4300/cop0.o \
	r4300/special.o \
	r4300/regimm.o \
	r4300/exception.o \
	r4300/Invalid_Code.o \
	r4300/interupt.o \
	r4300/cop1.o \
	r4300/tlb.o \
	r4300/cop1_w.o \
	r4300/cop1_s.o \
	r4300/cop1_d.o \
	r4300/bc.o \
	r4300/cop1_l.o \
	r4300/pure_interp.o \
	r4300/compare_core.o \
	r4300/profile.o \
	gc_memory/tlb.o \
	gc_memory/TLB-Cache-hash.o \
	gc_memory/memory.o \
	gc_memory/dma.o \
	gc_memory/pif.o \
	gc_memory/flashram.o \
	gc_memory/n64_cic_nus_6105.o \
	gc_input/input.o \
	rsp_hle/alist.o \
	rsp_hle/alist_audio.o \
	rsp_hle/alist_naudio.o \
	rsp_hle/alist_nead.o \
	rsp_hle/audio.o \
	rsp_hle/cicx105.o \
	rsp_hle/hle.o \
	rsp_hle/hvqm.o \
	rsp_hle/jpeg.o \
	rsp_hle/memory.o \
	rsp_hle/mp3.o \
	rsp_hle/musyx.o \
	rsp_hle/re2.o \
	rsp_hle/plugin.o

SOURCE_OBJS = main/main_dc.o \
	fileBrowser/fileBrowser.o \
	fileBrowser/fileBrowser-kos.o \
	gc_input/controller-DC.o \
	gc_audio/audio-dc.o \
	$(CORE_OBJS)

ifeq ($(GFX),soft)
SOURCE_OBJS += platform/dc_soft.o $(addprefix mupen64_soft_gfx/,rsp.o rdp.o rs.o tx.o tf.o cc.o bl.o)
endif

DC_DEFS = -D__DREAMCAST__ -D__LINUX__ -DNOASM -DUSE_TLB_CACHE -DPIXEL_FORMAT=RGB565
# Legacy register/memory views intentionally alias 32-bit and 64-bit words.
ifeq ($(GFX),soft)
DC_DEFS += -DDC_SOFT_GFX
ifeq ($(GAME_DISC),1)
DC_DEFS += -DDC_GAME_DISC
endif
endif
DC_DEFS += -fno-strict-aliasing -include platform/dc_abi.h

ifeq ($(HOST),1)
CC = gcc
CFLAGS ?= -std=gnu11 -fgnu89-inline -Wall -Wextra -Wno-unused-parameter \
    -Wno-missing-field-initializers -Wno-unused-function \
    -Wno-unused-variable -Wno-pointer-sign -Wno-multichar -O1 -g
CPPFLAGS += $(DC_DEFS) -DDC_HOST_STUB
BUILD_DIR ?= build/dc/host-$(shell $(CC) -dumpmachine)$(GFX_SUFFIX)
TARGET = $(BUILD_DIR)/not64-dc-bringup
RUNNER ?=
DC_CC = $(CC)
DC_CXX = $(subst gcc,g++,$(CC))
DC_CFLAGS = $(CPPFLAGS) $(CFLAGS)
DC_LDFLAGS = $(LDFLAGS)
DC_LIBS = -lm
else
ifndef KOS_BASE
$(error KOS_BASE is not set. Source KallistiOS environ.sh, or use the documented Docker builds in tools/dc/README.md)
endif
include $(KOS_BASE)/Makefile.rules
VIDEO ?= software
ifeq ($(filter $(VIDEO),software pvr),)
$(error VIDEO must be software or pvr)
endif
SOURCE_OBJS += platform/dc_video_kos.o
ifeq ($(VIDEO),pvr)
SOURCE_OBJS += platform/dc_pvr.o
DC_DEFS += -DDC_VIDEO_PVR
TARGET = not64-dc-pvr$(GFX_SUFFIX)$(GAME_SUFFIX).elf
else
TARGET = not64-dc$(GFX_SUFFIX)$(GAME_SUFFIX).elf
endif
ifeq ($(DEMO),1)
DC_DEFS += -DDC_EMBED_VITEST
BUILD_DIR ?= build/dc/kos-$(VIDEO)$(GFX_SUFFIX)-demo
TARGET = not64-dc-$(VIDEO)$(GFX_SUFFIX)-demo.elf
DEMO_OBJ = $(BUILD_DIR)/romdisk.o
else
BUILD_DIR ?= build/dc/kos-$(VIDEO)$(GFX_SUFFIX)$(GAME_SUFFIX)
endif
DC_CC = $(KOS_CC)
DC_CXX = $(subst gcc,g++,$(KOS_CC))
DC_CFLAGS = $(KOS_CFLAGS) $(DC_DEFS) -I$(CURDIR) -std=gnu11 -fgnu89-inline
DC_LDFLAGS = $(KOS_LDFLAGS) -Wl,-Map,$(BUILD_DIR)/not64-dc.map
DC_LIBS = $(OBJEXTRA) $(KOS_LIBS) -lm
endif

ifeq ($(GFX),soft)
DC_LIBS := -Wl,--start-group -lstdc++ $(DC_LIBS) -Wl,--end-group
endif

OBJS = $(addprefix $(BUILD_DIR)/,$(SOURCE_OBJS))
TEST_OBJS = $(BUILD_DIR)/tests/dc/test_contract.o $(BUILD_DIR)/tests/dc/rsp_memory_probe.o
TEST_TARGET = $(BUILD_DIR)/test-contract
VI_TEST_TARGET = $(BUILD_DIR)/test-vi
ROMS = roms/dc_dummy.z64 roms/dc_cputest.z64 roms/dc_vitest.z64
CONFIG_STAMP = $(BUILD_DIR)/compiler-flags

.PHONY: all clean run test FORCE
all: $(ROMS) $(TARGET)

# A stamp avoids races between the two ROM outputs under parallel make.
$(BUILD_DIR)/roms.stamp: roms/gen_dc_roms.py
	@mkdir -p $(@D)
	python3 $<
	@touch $@

$(ROMS): $(BUILD_DIR)/roms.stamp
	@test -f $@ || python3 roms/gen_dc_roms.py

# Rebuild when compiler/options change, even within one target architecture.
$(CONFIG_STAMP): FORCE
	@mkdir -p $(@D)
	@printf '%s\n' '$(DC_CC) $(DC_CFLAGS) $(DC_LDFLAGS) $(DC_LIBS)' > $@.tmp
	@cmp -s $@.tmp $@ && rm $@.tmp || mv $@.tmp $@

$(TARGET): $(OBJS) $(DEMO_OBJ)
	$(DC_CC) $(DC_CFLAGS) $(DC_LDFLAGS) -o $@ $(KOS_START) $(OBJS) $(DEMO_OBJ) $(DC_LIBS)

ifeq ($(DEMO),1)
$(BUILD_DIR)/romdisk.o: roms/dc_vitest.z64
	@mkdir -p $(BUILD_DIR)/romdisk/roms
	cp $< $(BUILD_DIR)/romdisk/roms/
	$(KOS_GENROMFS) -f $(BUILD_DIR)/romdisk.img -d $(BUILD_DIR)/romdisk
	$(KOS_BASE)/utils/bin2o/bin2o $(BUILD_DIR)/romdisk.img romdisk $@
endif

$(BUILD_DIR)/%.o: %.c $(CONFIG_STAMP)
	@mkdir -p $(@D)
	$(DC_CC) $(DC_CFLAGS) -MMD -MP -c -o $@ $<

$(BUILD_DIR)/%.o: %.cpp $(CONFIG_STAMP)
	@mkdir -p $(@D)
	$(DC_CXX) $(filter-out -std=gnu11 -fgnu89-inline,$(DC_CFLAGS)) -std=gnu++11 -MMD -MP -c -o $@ $<

ifeq ($(HOST),1)
$(TEST_TARGET): $(filter-out $(BUILD_DIR)/main/main_dc.o,$(OBJS)) $(TEST_OBJS)
	$(DC_CC) $(DC_CFLAGS) $(DC_LDFLAGS) -o $@ $^ $(DC_LIBS)

SOFT_TEST_TARGET = $(BUILD_DIR)/test-soft
$(SOFT_TEST_TARGET): $(BUILD_DIR)/tests/dc/test_soft.o $(addprefix $(BUILD_DIR)/mupen64_soft_gfx/,rsp.o rdp.o rs.o tx.o tf.o cc.o bl.o)
	$(DC_CXX) $(filter-out -std=gnu11 -fgnu89-inline,$(DC_CFLAGS)) $(DC_LDFLAGS) -o $@ $^ $(DC_LIBS)

.PHONY: test-soft
test-soft: $(SOFT_TEST_TARGET)
	$(RUNNER) ./$(SOFT_TEST_TARGET)

run: all
	$(RUNNER) ./$(TARGET)

$(VI_TEST_TARGET): $(BUILD_DIR)/tests/dc/test_vi.o $(BUILD_DIR)/platform/dc_vi.o $(BUILD_DIR)/platform/dc_video.o
	$(DC_CC) $(DC_CFLAGS) $(DC_LDFLAGS) -o $@ $^ $(DC_LIBS)

test: all $(TEST_TARGET) $(VI_TEST_TARGET)
	$(RUNNER) ./$(TEST_TARGET)
	$(RUNNER) ./$(VI_TEST_TARGET)
	$(RUNNER) ./$(TARGET) roms/dc_cputest.z64
	$(RUNNER) ./$(TARGET) roms/dc_dummy.z64
	$(RUNNER) ./$(TARGET) roms/dc_vitest.z64 300000 --frames 2 --capture $(BUILD_DIR)/vitest.ppm
	python3 tests/dc/check_capture.py $(BUILD_DIR)/vitest.ppm
	python3 tests/dc/check_rom_formats.py $(RUNNER) ./$(TARGET)
endif

clean:
	rm -f $(OBJS) $(TEST_OBJS) $(OBJS:.o=.d) $(TEST_OBJS:.o=.d) $(TARGET) $(TEST_TARGET) $(VI_TEST_TARGET) $(BUILD_DIR)/tests/dc/test_vi.o $(BUILD_DIR)/tests/dc/test_vi.d $(CONFIG_STAMP) $(BUILD_DIR)/roms.stamp

-include $(OBJS:.o=.d) $(TEST_OBJS:.o=.d) $(BUILD_DIR)/tests/dc/test_vi.d

# Run from the repository root. Independent synthetic target, no game ROM.
HOST ?= 0
STRICT ?= 0
REFERENCE ?= 0
OUT ?= build/dc/raster-replay-$(HOST)-$(STRICT)$(if $(filter 1,$(REFERENCE)),-reference,)
SOURCES = tests/dc/test_raster_replay.cpp $(addprefix mupen64_soft_gfx/,rdp.cpp rs.cpp tx.cpp tf.cpp cc.cpp bl.cpp)
DEFS = -D__DREAMCAST__ -D__LINUX__ -DNOASM -DDC_RASTER_REPLAY -DPIXEL_FORMAT=RGB565 -I. -include platform/dc_abi.h
ifeq ($(REFERENCE),1)
DEFS += -DDC_SOFT_REFERENCE
endif
ifeq ($(HOST),1)
CXX = arm-linux-gnueabihf-g++
FLAGS = -O2 -fno-strict-aliasing -std=gnu++11
LIBS = -lm
else
include $(KOS_BASE)/Makefile.rules
CXX = $(patsubst %gcc,%g++,$(KOS_CC))
FLAGS = $(KOS_CFLAGS) -O2 -fno-strict-aliasing -std=gnu++11
LINK = $(KOS_LDFLAGS)
LIBS = -lstdc++ $(KOS_LIBS)
DEFS += -DDC_RASTER_PVR
SOURCES += platform/dc_raster_pvr.cpp
EXTRA = $(OUT)/dc_kos_compat.o
ifeq ($(STRICT),1)
DEFS += -DDC_RASTER_STRICT
endif
endif
.PHONY: all
all: $(OUT)/replay.elf
$(OUT)/dc_kos_compat.o: platform/dc_kos_compat.c
	@mkdir -p $(OUT)
	$(KOS_CC) $(KOS_CFLAGS) -c $< -o $@
$(OUT)/replay.elf: $(SOURCES) $(EXTRA) $(wildcard mupen64_soft_gfx/*.h platform/dc_raster*.h) tests/dc/Makefile.raster-replay
	@mkdir -p $(OUT)
	$(CXX) $(FLAGS) $(DEFS) $(LINK) -o $@ $(SOURCES) $(EXTRA) $(LIBS)
